MIME-Version: 1.0
Content-Type: multipart/mixed; boundary="//"

--//
Content-Type: text/x-shellscript; charset="us-ascii"
#!/bin/bash
set -ex


TOKEN=$(curl -X PUT "http://169.254.169.254/latest/api/token" -H "X-aws-ec2-metadata-token-ttl-seconds: 21600")
AMI_ID=$(curl -H "X-aws-ec2-metadata-token: $TOKEN" http://169.254.169.254/latest/meta-data/ami-id)
INSTANCE_TYPE=$(curl -H "X-aws-ec2-metadata-token: $TOKEN" http://169.254.169.254/latest/meta-data/instance-type)
CAPACITY_TYPE=$(curl -H "X-aws-ec2-metadata-token: $TOKEN" http://169.254.169.254/latest/meta-data/instance-life-cycle)

test ${CNI_ADDON} != false && MAX_PODS=$(/etc/eks/max-pods-calculator.sh --instance-type $INSTANCE_TYPE --cni-version ${CNI_VERSION}) && USE_MAX_PODS=true || USE_MAX_PODS=false

B64_CLUSTER_CA=${B64_CLUSTER_CA}
API_SERVER_URL=${API_SERVER_URL}
K8S_CLUSTER_DNS_IP=${K8S_CLUSTER_DNS_IP}  

/etc/eks/bootstrap.sh ${CLUSTER_NAME} --kubelet-extra-args "--node-labels=eks.amazonaws.com/nodegroup-image=$(echo $AMI_ID),eks.amazonaws.com/capacityType=$(echo $CAPACITY_TYPE),eks.amazonaws.com/nodegroup=${NODEGROUP}" --max-pods=$MAX_PODS --b64-cluster-ca $B64_CLUSTER_CA --apiserver-endpoint $API_SERVER_URL --dns-cluster-ip $K8S_CLUSTER_DNS_IP --use-max-pods $USE_MAX_PODS

--//--